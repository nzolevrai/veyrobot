# Copy outside the repository to .env.production and replace every placeholder securely.
# Generate independent random values for secrets; never commit .env.production.
NODE_ENV=production
VEYROBOT_IMAGE_TAG=replace_with_immutable_git_sha
API_PUBLIC_URL=https://dashboard.example.invalid/api
DASHBOARD_URL=https://dashboard.example.invalid
API_INTERNAL_URL=http://api:4000
API_PORT=4000

POSTGRES_USER=veyrobot
POSTGRES_PASSWORD=replace_with_url_encoded_random_password
POSTGRES_DB=veyrobot
DATABASE_URL=postgresql://veyrobot:replace_with_url_encoded_random_password@postgres:5432/veyrobot?schema=public
DATABASE_POOL_SIZE=10

# Starting resource envelopes, not server-capacity guarantees.
POSTGRES_MEMORY_LIMIT=1G
MIGRATE_MEMORY_LIMIT=512M
MIGRATE_NODE_HEAP_MB=256
API_MEMORY_LIMIT=512M
API_NODE_HEAP_MB=256
BOT_MEMORY_LIMIT=768M
BOT_NODE_HEAP_MB=384
DASHBOARD_MEMORY_LIMIT=512M
DASHBOARD_NODE_HEAP_MB=256
REDIS_MEMORY_LIMIT=512M
REDIS_MAXMEMORY=256mb

REDIS_PASSWORD=replace_with_random_password
REDIS_URL=redis://:replace_with_url_encoded_random_password@redis:6379

DISCORD_CLIENT_ID=replace_with_application_id
DISCORD_CLIENT_SECRET=replace_with_oauth_client_secret
DISCORD_BOT_TOKEN=replace_with_bot_token
SESSION_KEY=replace_with_64_hex_characters
API_PROXY_CLIENT_IP_SECRET=INVALID_SET_A_RANDOM_SECRET

# Leave empty. The API uses signed client identity from Next, not raw forwarded headers.
API_TRUSTED_PROXIES=
API_RATE_LIMIT_MAX=90
# Aggregate per-IP ceiling before session grants are checked; keep above API_RATE_LIMIT_MAX for shared networks.
API_PREAUTH_RATE_LIMIT_MAX=180
MAX_PENDING_GLOBAL=5000
MAX_PENDING_PER_GUILD=100
