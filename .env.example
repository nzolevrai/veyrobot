NODE_ENV=development
DATABASE_URL=postgresql://sentinelle:sentinelle_local@localhost:5432/sentinelle?schema=public
VEYROBOT_RECOVERY_EPOCH=replace_with_external_random_value_at_least_32_characters
DATABASE_POOL_SIZE=10
MAX_PENDING_GLOBAL=5000
MAX_PENDING_PER_GUILD=100
RETENTION_SESSION_DAYS=30
RETENTION_AUDIT_DAYS=730
RETENTION_WARNING_DAYS=1095
RETENTION_BATCH_SIZE=100
RETENTION_MAX_BATCHES=10
REDIS_URL=redis://localhost:6379
API_PORT=4000
API_RATE_LIMIT_MAX=90
# Requests per minute per client IP before session validation (bounds grant lookups).
API_PREAUTH_RATE_LIMIT_MAX=180
# Comma-separated exact proxy IPs/CIDRs. Leave empty if the API cannot verify its direct proxy peer.
API_TRUSTED_PROXIES=
# Optional HMAC shared only by Next and API; set for per-client anonymous API buckets behind Next.
API_PROXY_CLIENT_IP_SECRET=replace_with_random_32_byte_secret
# Exact header overwritten by trusted ingress (commonly x-real-ip); empty disables client-IP forwarding.
DASHBOARD_TRUSTED_CLIENT_IP_HEADER=
API_PUBLIC_URL=http://localhost:4000
DASHBOARD_URL=http://localhost:3000
SUPPORT_DISCORD_URL=
API_INTERNAL_URL=http://api:4000
API_PROXY_BODY_TIMEOUT_MS=15000
API_PROXY_TIMEOUT_MS=10000
DISCORD_CLIENT_ID=replace_with_application_id
DISCORD_CLIENT_SECRET=replace_with_oauth_client_secret
DISCORD_BOT_TOKEN=replace_with_bot_token
DISCORD_TEST_GUILD_ID=replace_with_test_server_id
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_KEY=replace_with_64_hex_characters
